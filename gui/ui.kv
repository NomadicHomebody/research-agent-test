#:import Window kivy.core.window.Window

<MainLayout>:
    orientation: 'horizontal'
    DynamicBackground:
        id: bg
    BoxLayout:
        orientation: 'vertical'
        size_hint_x: 0.5
        padding: 20
        spacing: 10

        TextInput:
            id: topic_input
            hint_text: "Enter research topic..."
            size_hint_y: 0.6
            font_size: 20

        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: 0.15
            spacing: 10

            Button:
                id: submit_btn
                text: "Submit"
                on_release: app.on_submit()

            Button:
                id: clear_btn
                text: "Clear"
                on_release: app.on_clear()

            Button:
                id: save_btn
                text: "Save"
                on_release: app.on_save()

        BoxLayout:
            orientation: 'vertical'
            size_hint_y: 0.25
            padding: [0, 20, 0, 0]
            Image:
                id: logo
                source: 'assets/logo.png'
                size_hint_y: 0.7
            Label:
                text: "AI Research Agent"
                font_size: 18
                size_hint_y: 0.3
                halign: 'center'
                valign: 'middle'

    BoxLayout:
        orientation: 'vertical'
        size_hint_x: 0.5
        padding: 20
        spacing: 10

        # MarkdownViewer:
        MarkdownViewer:
            id: markdown_output
            text: "Markdown output will appear here."
            font_size: 16
            size_hint_y: 0.8
            halign: 'left'
            valign: 'top'

        # StatusPanel:
        Label:
            id: status_panel
            text: "Status: Idle"
            font_size: 14
            size_hint_y: 0.2
            halign: 'left'
            valign: 'middle'